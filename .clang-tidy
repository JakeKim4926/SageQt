Checks: >
  -*,
  readability-identifier-naming,
  modernize-use-nullptr,
  google-readability-casting,
  google-explicit-constructor,
  modernize-use-override,
  readability-make-member-function-const
WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(_autogen|/out/)'
CheckOptions:
  readability-identifier-naming.AbstractClassCase: CamelCase
  readability-identifier-naming.AbstractClassPrefix: ISage
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.ClassPrefix: Sage
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.StructPrefix: Sage
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumPrefix: Sage
  readability-identifier-naming.ScopedEnumConstantCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.MemberPrefix: m_
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.GlobalConstantCase: UPPER_CASE
  readability-identifier-naming.GlobalConstantPrefix: SAGE_
  readability-identifier-naming.ConstexprVariableCase: UPPER_CASE
  readability-identifier-naming.ConstexprVariablePrefix: SAGE_
